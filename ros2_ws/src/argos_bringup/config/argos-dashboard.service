# ============================================================================
# argos-dashboard.service — Pi Node dashboard server unit (not auto-installed)
# ============================================================================
#
# This systemd unit launches the React/Node dashboard server (port 8787) on
# the Raspberry Pi. It is NOT installed by the colcon build — copy it into
# /etc/systemd/system/ by hand only after you have reviewed the paths below
# and confirmed a `ros2 launch quadruped_bringup full_system.launch.py
# enable_dashboard:=true` works on your Pi.
#
# Prereqs
#   - /home/pi/argos is a clone of this repo (adjust WorkingDirectory if not)
#   - `cd /home/pi/argos/dashboard && npm install && npm run build` has run
#     at least once
#   - `ros-humble-rosbridge-server` apt package is installed (the ROS 2
#     launch file brings it up on 9090 — the Node server proxies to it)
#   - If you run rosbridge separately as `ros2-ready.service`, this unit
#     waits for that target; otherwise `After=network-online.target` alone
#     is sufficient since the Node server retries rosbridge connection
#
# Install
#   sudo cp ros2_ws/src/argos_bringup/config/argos-dashboard.service \
#       /etc/systemd/system/argos-dashboard.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now argos-dashboard.service
#
# Inspect / logs
#   systemctl status argos-dashboard.service
#   journalctl -u argos-dashboard.service -f
#
# Uninstall
#   sudo systemctl disable --now argos-dashboard.service
#   sudo rm /etc/systemd/system/argos-dashboard.service
#   sudo systemctl daemon-reload
#
# Notes
#   - The PORT environment variable defaults to 8787 in server.js; override
#     here if you need to.
#   - ROSBRIDGE_URL defaults to ws://localhost:9090; the Node server retries
#     on disconnect, so starting this unit before rosbridge is fine.
# ============================================================================

[Unit]
Description=Argos dashboard Node server (React SPA + /telemetry WebSocket on port 8787)
Documentation=file:///home/pi/argos/docs/dashboard_guide.md
After=network-online.target ros2-ready.service
Wants=network-online.target
# ros2-ready.service is optional — drop it if you do not use that target.

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/argos/dashboard
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=ROSBRIDGE_URL=ws://localhost:9090
ExecStart=/usr/bin/node /home/pi/argos/dashboard/pi_server/server.js
Restart=on-failure
RestartSec=3
# Hardening — the dashboard only needs to write to ~/.argos/, so the home
# directory is writable but the rest of the filesystem is read-only.
ProtectSystem=full
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=argos-dashboard

[Install]
WantedBy=multi-user.target
