# Argos udev rules for the Raspberry Pi.
# Replace these with serial-number-specific rules once the final hardware is on hand.
#
# Install on the Pi:
#   sudo cp 99-argos-devices.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Check devices:
#   udevadm info -a -n /dev/ttyUSB0
#   udevadm info -a -n /dev/ttyACM0

# RPLiDAR A1M8 via CP2102 USB-UART bridge
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="ttyLIDAR", GROUP="dialout", MODE="0660"

# ESP32 dev boards vary a lot. The current Feather HUZZAH32 uses a USB-UART
# bridge, so you should match on SERIAL as well as vendor/product; otherwise it
# can collide with the LiDAR's CP210x bridge and both devices may claim the
# same alias. Discover the fields with:
#
#   udevadm info -a -n /dev/ttyUSB0 | grep -E '{idVendor}|{idProduct}|{serial}'
#
# Example for a CP210x-based ESP32 board:
# SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="<board-serial>", SYMLINK+="ttyESP32", GROUP="dialout", MODE="0660"
#
# Native-USB ESP32-C6 boards often look like this instead:
# SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", ATTRS{serial}=="<board-serial>", SYMLINK+="ttyESP32", GROUP="dialout", MODE="0660"
