#!/usr/bin/env python3
"""Check individual Argos hardware components from the Pi side.

This script supports two kinds of checks:
  - preflight: host/device/USB/I2C checks before ROS is running
  - ROS topic checks: validate that launched components are actually publishing

Run from source with:
  python3 ros2_ws/src/quadruped_bringup/scripts/argos_component_check preflight

Or after the workspace is built and sourced with:
  ros2 run quadruped_bringup argos_component_check preflight
"""

from __future__ import annotations

import argparse
import math
from dataclasses import dataclass, field
from pathlib import Path
import shutil
import subprocess
import sys
import time
from typing import Any, Callable


ResultLevel = str


@dataclass
class Result:
    level: ResultLevel
    label: str
    detail: str


@dataclass
class TopicSpec:
    label: str
    topic: str
    msg_type: Any
    min_messages: int
    min_rate_hz: float | None
    validator: Callable[[Any], str | None]
    formatter: Callable[[Any], str]


@dataclass
class TopicState:
    spec: TopicSpec
    count: int = 0
    first_rx_s: float | None = None
    last_rx_s: float | None = None
    last_error: str | None = None
    last_detail: str = ""

    def record(self, msg: Any) -> None:
        now = time.monotonic()
        if self.first_rx_s is None:
            self.first_rx_s = now
        self.last_rx_s = now
        self.count += 1
        self.last_error = self.spec.validator(msg)
        self.last_detail = self.spec.formatter(msg)

    def rate_hz(self) -> float | None:
        if self.count < 2 or self.first_rx_s is None or self.last_rx_s is None:
            return None
        duration = self.last_rx_s - self.first_rx_s
        if duration <= 0.0:
            return None
        return (self.count - 1) / duration

    def passed(self) -> bool:
        if self.count < self.spec.min_messages:
            return False
        if self.last_error is not None:
            return False
        if self.spec.min_rate_hz is None:
            return True
        rate = self.rate_hz()
        return rate is not None and rate >= self.spec.min_rate_hz


def print_result(result: Result) -> None:
    print(f"[{result.level}] {result.label}: {result.detail}")


def summarize_and_exit(results: list[Result]) -> int:
    fail_count = sum(1 for result in results if result.level == "FAIL")
    warn_count = sum(1 for result in results if result.level == "WARN")
    pass_count = sum(1 for result in results if result.level == "PASS")
    for result in results:
        print_result(result)
    print(
        f"\nSummary: {pass_count} passed, {warn_count} warnings, {fail_count} failed."
    )
    return 0 if fail_count == 0 else 1


def run_command(command: list[str], timeout_s: float = 5.0) -> tuple[bool, str]:
    try:
        completed = subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=timeout_s,
            check=False,
        )
    except FileNotFoundError:
        return False, "command not found"
    except subprocess.TimeoutExpired:
        return False, "timed out"

    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip() or "non-zero exit"
        return False, detail
    return True, completed.stdout.strip()


def check_command(name: str, *, required: bool = True) -> Result:
    if shutil.which(name):
        return Result("PASS", f"command {name}", "found in PATH")
    level = "FAIL" if required else "WARN"
    return Result(level, f"command {name}", "not found in PATH")


def check_path(path: str, label: str, *, required: bool = True) -> Result:
    if Path(path).exists():
        return Result("PASS", label, f"{path} present")
    level = "FAIL" if required else "WARN"
    return Result(level, label, f"{path} missing")


def check_lsusb(patterns: tuple[str, ...], label: str, *, required: bool) -> Result:
    ok, output = run_command(["lsusb"])
    if not ok:
        level = "WARN" if required else "WARN"
        return Result(level, label, f"could not run lsusb: {output}")

    lowered = output.lower()
    if any(pattern.lower() in lowered for pattern in patterns):
        return Result("PASS", label, "USB device detected by lsusb")
    level = "FAIL" if required else "WARN"
    return Result(level, label, "USB device not visible in lsusb output")


def check_i2c_address(bus: int, address: int, *, required: bool) -> Result:
    bus_path = f"/dev/i2c-{bus}"
    if not Path(bus_path).exists():
        level = "FAIL" if required else "WARN"
        return Result(level, f"I2C bus {bus}", f"{bus_path} missing")

    if not shutil.which("i2cdetect"):
        level = "FAIL" if required else "WARN"
        return Result(level, f"I2C address 0x{address:02X}", "i2cdetect not installed")

    ok, output = run_command(["i2cdetect", "-y", str(bus)], timeout_s=8.0)
    if not ok:
        level = "FAIL" if required else "WARN"
        return Result(level, f"I2C address 0x{address:02X}", f"i2cdetect failed: {output}")

    token = f"{address:02x}"
    lines = output.lower().splitlines()
    if any(token in line.split() for line in lines):
        return Result("PASS", f"I2C address 0x{address:02X}", "device responded on the bus")
    level = "FAIL" if required else "WARN"
    return Result(level, f"I2C address 0x{address:02X}", "device not found on the bus")


def run_preflight(args: argparse.Namespace) -> int:
    results: list[Result] = [
        check_command("python3", required=True),
        check_command("ros2", required=True),
        check_command("colcon", required=True),
        check_command("micro_ros_agent", required=True),
        check_command("lsusb", required=False),
        check_command("i2cdetect", required=False),
        check_path("/dev/ttyESP32", "ESP32 serial alias", required=True),
        check_path("/dev/ttyLIDAR", "RPLidar serial alias", required=args.expect_lidar),
    ]

    if args.expect_realsense:
        results.append(
            check_lsusb(
                ("RealSense", "Intel Corp."),
                "RealSense USB camera",
                required=True,
            )
        )

    if args.expect_lidar:
        results.append(
            check_lsusb(
                ("CP210", "Silicon Labs"),
                "RPLidar USB adapter",
                required=False,
            )
        )

    if args.expect_thermal:
        results.append(check_path("/dev/i2c-1", "Pi I2C bus", required=True))
        if not args.skip_i2c_scan:
            results.append(
                check_i2c_address(args.i2c_bus, args.thermal_address, required=True)
            )

    return summarize_and_exit(results)


def import_ros_modules() -> dict[str, Any]:
    import rclpy
    from rclpy.node import Node
    from rclpy.qos import qos_profile_sensor_data
    from sensor_msgs.msg import CameraInfo, Image, Imu, JointState, LaserScan
    from std_msgs.msg import Float32

    return {
        "rclpy": rclpy,
        "Node": Node,
        "qos_profile_sensor_data": qos_profile_sensor_data,
        "CameraInfo": CameraInfo,
        "Image": Image,
        "Imu": Imu,
        "JointState": JointState,
        "LaserScan": LaserScan,
        "Float32": Float32,
    }


def format_rate(rate_hz: float | None) -> str:
    return "n/a" if rate_hz is None else f"{rate_hz:.1f} Hz"


def validate_joint_state(msg: Any) -> str | None:
    if len(msg.position) != 12:
        return f"expected 12 joint positions, got {len(msg.position)}"
    return None


def validate_imu(msg: Any) -> str | None:
    values = (
        msg.linear_acceleration.x,
        msg.linear_acceleration.y,
        msg.linear_acceleration.z,
        msg.angular_velocity.x,
        msg.angular_velocity.y,
        msg.angular_velocity.z,
    )
    if not all(math.isfinite(value) for value in values):
        return "IMU message contains non-finite values"
    return None


def validate_gas(msg: Any) -> str | None:
    if not math.isfinite(msg.data):
        return "gas reading is not finite"
    return None


def validate_scan(msg: Any) -> str | None:
    finite_ranges = [value for value in msg.ranges if math.isfinite(value) and value > 0.0]
    if len(finite_ranges) < 10:
        return "too few finite scan ranges"
    return None


def validate_image(msg: Any) -> str | None:
    if msg.width <= 0 or msg.height <= 0:
        return "image has invalid dimensions"
    if not msg.data:
        return "image payload is empty"
    return None


def validate_camera_info(msg: Any) -> str | None:
    if msg.width <= 0 or msg.height <= 0:
        return "camera info has invalid dimensions"
    return None


def format_joint_state(msg: Any) -> str:
    return f"{len(msg.position)} positions"


def format_imu(msg: Any) -> str:
    return (
        "acc=("
        f"{msg.linear_acceleration.x:.2f},"
        f"{msg.linear_acceleration.y:.2f},"
        f"{msg.linear_acceleration.z:.2f})"
    )


def format_gas(msg: Any) -> str:
    return f"last={msg.data:.1f}"


def format_scan(msg: Any) -> str:
    finite_ranges = [value for value in msg.ranges if math.isfinite(value) and value > 0.0]
    return f"finite={len(finite_ranges)}/{len(msg.ranges)}"


def format_image(msg: Any) -> str:
    return f"{msg.width}x{msg.height} {msg.encoding}"


def format_camera_info(msg: Any) -> str:
    return f"{msg.width}x{msg.height}"


def build_topic_specs(args: argparse.Namespace, ros: dict[str, Any]) -> tuple[str, list[TopicSpec]]:
    JointState = ros["JointState"]
    Imu = ros["Imu"]
    Float32 = ros["Float32"]
    LaserScan = ros["LaserScan"]
    Image = ros["Image"]
    CameraInfo = ros["CameraInfo"]

    camera_root = f"/{args.camera_name}/{args.camera_name}"

    specs_by_command: dict[str, tuple[str, list[TopicSpec]]] = {
        "esp32": (
            "Start ros2 launch quadruped_bringup esp32_bridge.launch.py first.",
            [
                TopicSpec(
                    label="joint states",
                    topic="/joint_states",
                    msg_type=JointState,
                    min_messages=4,
                    min_rate_hz=20.0,
                    validator=validate_joint_state,
                    formatter=format_joint_state,
                ),
                TopicSpec(
                    label="imu",
                    topic="/imu/data_raw",
                    msg_type=Imu,
                    min_messages=4,
                    min_rate_hz=20.0,
                    validator=validate_imu,
                    formatter=format_imu,
                ),
                TopicSpec(
                    label="gas",
                    topic="/gas",
                    msg_type=Float32,
                    min_messages=2,
                    min_rate_hz=2.0,
                    validator=validate_gas,
                    formatter=format_gas,
                ),
            ],
        ),
        "imu": (
            "Start ros2 launch quadruped_bringup esp32_bridge.launch.py first.",
            [
                TopicSpec(
                    label="imu",
                    topic="/imu/data_raw",
                    msg_type=Imu,
                    min_messages=4,
                    min_rate_hz=20.0,
                    validator=validate_imu,
                    formatter=format_imu,
                ),
            ],
        ),
        "gas": (
            "Start ros2 launch quadruped_bringup esp32_bridge.launch.py first.",
            [
                TopicSpec(
                    label="gas",
                    topic="/gas",
                    msg_type=Float32,
                    min_messages=2,
                    min_rate_hz=2.0,
                    validator=validate_gas,
                    formatter=format_gas,
                ),
            ],
        ),
        "lidar": (
            "Start ros2 launch quadruped_bringup rplidar.launch.py first.",
            [
                TopicSpec(
                    label="lidar scan",
                    topic="/scan",
                    msg_type=LaserScan,
                    min_messages=2,
                    min_rate_hz=3.0,
                    validator=validate_scan,
                    formatter=format_scan,
                ),
            ],
        ),
        "realsense": (
            "Start ros2 launch quadruped_bringup realsense.launch.py first.",
            [
                TopicSpec(
                    label="color image",
                    topic=f"{camera_root}/color/image_raw",
                    msg_type=Image,
                    min_messages=2,
                    min_rate_hz=5.0,
                    validator=validate_image,
                    formatter=format_image,
                ),
                TopicSpec(
                    label="depth image",
                    topic=f"{camera_root}/aligned_depth_to_color/image_raw",
                    msg_type=Image,
                    min_messages=2,
                    min_rate_hz=5.0,
                    validator=validate_image,
                    formatter=format_image,
                ),
                TopicSpec(
                    label="depth camera info",
                    topic=f"{camera_root}/aligned_depth_to_color/camera_info",
                    msg_type=CameraInfo,
                    min_messages=1,
                    min_rate_hz=None,
                    validator=validate_camera_info,
                    formatter=format_camera_info,
                ),
            ],
        ),
        "thermal": (
            "Start ros2 launch quadruped_bringup mission_stack.launch.py first.",
            [
                TopicSpec(
                    label="thermal image",
                    topic="/thermal/image_raw",
                    msg_type=Image,
                    min_messages=2,
                    min_rate_hz=1.0,
                    validator=validate_image,
                    formatter=format_image,
                ),
                TopicSpec(
                    label="thermal camera info",
                    topic="/thermal/camera_info",
                    msg_type=CameraInfo,
                    min_messages=1,
                    min_rate_hz=None,
                    validator=validate_camera_info,
                    formatter=format_camera_info,
                ),
            ],
        ),
    }

    full_hint = (
        "Start esp32_bridge.launch.py plus sensors.launch.py first. "
        "Add mission_stack.launch.py if you pass --include-thermal."
    )
    full_specs = (
        specs_by_command["esp32"][1]
        + specs_by_command["lidar"][1]
        + specs_by_command["realsense"][1]
    )
    if getattr(args, "include_thermal", False):
        full_specs += specs_by_command["thermal"][1]
    specs_by_command["full"] = (full_hint, full_specs)

    return specs_by_command[args.command]


def run_ros_topic_checks(args: argparse.Namespace) -> int:
    try:
        ros = import_ros_modules()
    except ImportError as exc:
        print(
            "ROS Python modules are not available. Source the workspace and make sure "
            "rclpy plus the message packages are installed."
        )
        print(f"Import error: {exc}")
        return 1

    rclpy = ros["rclpy"]
    Node = ros["Node"]
    qos_profile_sensor_data = ros["qos_profile_sensor_data"]

    hint, specs = build_topic_specs(args, ros)
    states = [TopicState(spec=spec) for spec in specs]

    class ComponentCheckNode(Node):
        def __init__(self) -> None:
            super().__init__("argos_component_check")
            self._subscriptions = []
            for state in states:
                subscription = self.create_subscription(
                    state.spec.msg_type,
                    state.spec.topic,
                    self._make_callback(state),
                    qos_profile_sensor_data,
                )
                self._subscriptions.append(subscription)

        @staticmethod
        def _make_callback(state: TopicState) -> Callable[[Any], None]:
            def callback(msg: Any) -> None:
                state.record(msg)

            return callback

    rclpy.init(args=None)
    node = ComponentCheckNode()

    try:
        deadline = time.monotonic() + args.timeout
        while rclpy.ok() and time.monotonic() < deadline:
            rclpy.spin_once(node, timeout_sec=0.1)
            if all(state.passed() for state in states):
                break
    finally:
        node.destroy_node()
        rclpy.shutdown()

    results: list[Result] = []
    for state in states:
        rate = format_rate(state.rate_hz())
        detail = f"topic={state.spec.topic} msgs={state.count} rate={rate}"
        if state.last_detail:
            detail += f" detail={state.last_detail}"

        if state.passed():
            results.append(Result("PASS", state.spec.label, detail))
            continue

        if state.count == 0:
            detail += " error=no messages received before timeout"
        elif state.last_error:
            detail += f" error={state.last_error}"
        elif state.spec.min_rate_hz is not None:
            detail += f" error=below target rate {state.spec.min_rate_hz:.1f} Hz"
        else:
            detail += " error=did not satisfy the requested criteria"
        results.append(Result("FAIL", state.spec.label, detail))

    exit_code = summarize_and_exit(results)
    if exit_code != 0:
        print(f"\nHint: {hint}")
    return exit_code


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Component checks for the physical Argos robot.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    preflight = subparsers.add_parser(
        "preflight",
        help="Check commands, device aliases, USB visibility, and optional I2C devices.",
    )
    preflight.add_argument(
        "--expect-lidar",
        action="store_true",
        help="Require the lidar alias and attempt a USB sanity check.",
    )
    preflight.add_argument(
        "--expect-realsense",
        action="store_true",
        help="Require the RealSense camera to appear in lsusb.",
    )
    preflight.add_argument(
        "--expect-thermal",
        action="store_true",
        help="Require /dev/i2c-1 and verify the thermal camera I2C address.",
    )
    preflight.add_argument(
        "--thermal-address",
        type=lambda value: int(value, 0),
        default=0x33,
        help="Thermal camera I2C address. Default: 0x33.",
    )
    preflight.add_argument(
        "--i2c-bus",
        type=int,
        default=1,
        help="Pi I2C bus number. Default: 1.",
    )
    preflight.add_argument(
        "--skip-i2c-scan",
        action="store_true",
        help="Skip the i2cdetect scan even if --expect-thermal is set.",
    )

    for command, help_text in (
        ("esp32", "Check the MCU bridge, /joint_states, /imu/data_raw, and /gas."),
        ("imu", "Check only the IMU topic."),
        ("gas", "Check only the gas topic."),
        ("lidar", "Check only /scan."),
        ("realsense", "Check RealSense color/depth topics."),
        ("thermal", "Check thermal image/camera info topics."),
        ("full", "Check the whole physical robot data path."),
    ):
        subparser = subparsers.add_parser(command, help=help_text)
        subparser.add_argument(
            "--timeout",
            type=float,
            default=10.0 if command in {"thermal", "full"} else 8.0,
            help="How long to wait for messages before failing.",
        )
        subparser.add_argument(
            "--camera-name",
            default="camera",
            help="RealSense camera namespace. Default: camera.",
        )
        if command == "full":
            subparser.add_argument(
                "--include-thermal",
                action="store_true",
                help="Also require the thermal camera topics.",
            )

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "preflight":
        return run_preflight(args)

    return run_ros_topic_checks(args)


if __name__ == "__main__":
    sys.exit(main())
