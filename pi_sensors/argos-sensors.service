[Unit]
Description=Argos sensor sidecar (RealSense + MLX90640)
After=network.target
Wants=network.target

[Service]
Type=simple
User=argos
Group=argos
WorkingDirectory=/home/argos/Argos/pi_sensors
ExecStart=/bin/bash -lc 'if [ -x .venv/bin/python ]; then exec .venv/bin/python sensor_server.py; else exec python3 sensor_server.py; fi'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
